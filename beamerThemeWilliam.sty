% Beamer Option
\newif\ifbeamer@secheader
\beamer@secheaderfalse

\DeclareOptionBeamer{rounded}{\beamer@secheadertrue}
\ProcessOptionsBeamer

\usecolortheme{William}
% \useinnertheme[shadow]{rounded}
\useinnertheme{rectangles}
