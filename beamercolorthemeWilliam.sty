\mode<presentation>
\RequirePackage[svgnames]{xcolor}


% Define all color used
\definecolor[named]{LightGray}{RGB}{230,230,230}
\definecolor{bleuLabSTICC}{RGB}{0,54,95}
\definecolor{labHC}{RGB}{234,96,18}
\setbeamercolor{footlinecolor}{fg=bleuLabSTICC, bg=black}
% \colorlet{beamer@blendedblue}{bleuLabSTICC}

% Associate each color to their part of the slide
% Title and Frame Elements
\setbeamercolor{title}{bg=labHC, fg=bleuLabSTICC} % Color of the presentation title.
\setbeamercolor{author}{bg=black, fg=black} % Color of the author's name.
\setbeamercolor{date}{bg=black, fg=black} % Color of the date.
\setbeamercolor{frametitle}{bg=black, fg=black} % Color of the frame title.
\setbeamercolor{framesubtitle}{bg=black, fg=black} % Color of the frame subtitle.
\setbeamercolor{headline}{bg=black, fg=black} % Color of the headline (usually the navigation bar at the top).
\setbeamercolor{footline}{bg=Yellow, fg=black} % Color of the footline (usually the navigation bar at the bottom).
\setbeamercolor{sidebar}{bg=black, fg=black} % Color of the sidebar.
\setbeamercolor{sidebarright}{bg=black, fg=black} % Color of the right sidebar.
\setbeamercolor{institute}{bg=black, fg=black} % Color of the institue.
\setbeamercolor{section}{bg=black, fg=black} % Color of the section.
\setbeamercolor{section in toc}{bg=black, fg=black} % Color of the section.
\setbeamercolor{subsection}{bg=black, fg=black} % Color of the subsection.
\setbeamercolor{subsubsection}{bg=black, fg=black} % Color of the subsubsection.

% Text Elements
\setbeamercolor{normal text}{bg=black, fg=black} % Color of the normal text.
\setbeamercolor{alerted text}{bg=black, fg=black} % Color of the alerted (highlighted) text.
\setbeamercolor{example text}{bg=black, fg=black} % Color of the example text.
\setbeamercolor{structure}{bg=black, fg=black} % Color of structural elements (e.g., section and subsection titles).

% Blocks and Environments
\setbeamercolor{block title}{bg=black, fg=black} % Color of the block title.
\setbeamercolor{block body}{bg=black, fg=black} % Color of the block body.
\setbeamercolor{block title alerted}{bg=black, fg=black} % Color of the alerted block title.
\setbeamercolor{block body alerted}{bg=black, fg=black} % Color of the alerted block body.
\setbeamercolor{block title example}{bg=black, fg=black} % Color of the example block title.
\setbeamercolor{block body example}{bg=black, fg=black} % Color of the example block body.
\setbeamercolor{block title theorem}{bg=black, fg=black} % Color of the theorem block title.
\setbeamercolor{block body theorem}{bg=black, fg=black} % Color of the theorem block body.

% Itemize and Enumerate
\setbeamercolor{item}{bg=black, fg=black} % Color of the itemize bullet points.
\setbeamercolor{subitem}{bg=black, fg=black} % Color of the subitem bullet points.
\setbeamercolor{itemize item}{bg=black, fg=black} % Color of the itemize items.
\setbeamercolor{itemize subitem}{bg=black, fg=black} % Color of the itemize subitems.
\setbeamercolor{itemize subsubitem}{bg=black, fg=black} % Color of the itemize subsubitems.
\setbeamercolor{enumerate item}{bg=black, fg=black} % Color of the enumerate items.
\setbeamercolor{enumerate subitem}{bg=black, fg=black} % Color of the enumerate subitems.
\setbeamercolor{enumerate subsubitem}{fg=black} % Color of the enumerate subsubitems.

% Navigation and Buttons
\setbeamercolor{navigation symbols}{bg=black, fg=black} % Color of the navigation symbols.
\setbeamercolor{button}{bg=black, fg=black} % Color of the buttons.
\setbeamercolor{button border}{bg=black, fg=black} % Color of the button borders.

% Miscellaneous
\setbeamercolor{palette primary}{fg=black, bg=black} % Primary color of the palette.
\setbeamercolor{palette secondary}{fg=black, bg=black} % Secondary color of the palette.
\setbeamercolor{palette tertiary}{fg=black, bg=black} % Tertiary color of the palette.
\setbeamercolor{palette quaternary}{fg=black, bg=black} % Quaternary color of the palette.

\setbeamercolor{background canvas}{bg=white} % Background color of the canvas.
\setbeamercolor{background}{bg=white} % Background color of the slides.

